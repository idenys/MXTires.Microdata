<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net461;net472;net48;net6.0;net8.0;net10.0</TargetFrameworks>
    <Version>1.0.5.0</Version>
    <Authors>1010Tires.com Inc.</Authors>
    <Company>1010Tires.com Inc.</Company>
    <Copyright>Copyright© 1010Tires.com Inc. 2023. All rights reserved.</Copyright>
    <Description>Converts .Net classes to Schema.org structured data in form of JSON-LD</Description>
    <PackageReleaseNotes>Breaking: JSON-LD output fixes (issue #42). All enumerations serialize as their schema.org/GoodRelations URI through one library-wide converter (SchemaEnumConverter); [Flags] combinations serialize as a JSON array; a member without a URI throws instead of writing a bare name or number. Enum, number and boolean properties are now nullable, so unset values are no longer written (e.g. Offer.ItemCondition, MerchantReturnPolicy fees/label sources, MonetaryAmount.MinValue/MaxValue, PriceSpecification.ValueAddedTaxIncluded, Rating.BestRating/WorstRating). schema.org URIs use https, including the default @context, which is now written on the root node only. Date-only properties (e.g. Offer.PriceValidUntil, Person.BirthDate) serialize as yyyy-MM-dd. ToJson/ToIndentedJson are virtual. Tire and Wheel no longer add hardcoded sameAs links; Wheel serializes as @type Product; Tire gets typed specs that serialize into additionalProperty. Fixed ReturnMethodEnumeration (all members wrote ReturnInStore), trailing spaces in Tuesday/DeliveryModePickUp URIs, Vehicle.SteeringPosition and Flight.EstimatedFlightDuration typed as DateTime, and TrackAction.DeliveryMethod being private. See ChangeLog.md for full details.</PackageReleaseNotes>
    <PackageTags>.Net Microdata Schema.org Json-LD</PackageTags>
    <PackageLicenseFile>License.md</PackageLicenseFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>MXTires.MicroData.snk</AssemblyOriginatorKeyFile>
    <RepositoryUrl>https://github.com/idenys/MXTires.Microdata</RepositoryUrl>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <Title>MXTires.Microdata</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <None Include=".paket\paket.exe" />
    <None Include=".paket\paket.targets" />
    <None Include="License.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>
<ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.ComponentModel.Annotations">
      <Version>5.0.0</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="System.ComponentModel.Annotations">
      <Version>5.0.0</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="System.ComponentModel.Annotations">
      <Version>5.0.0</Version>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netcoreapp3.1'">
    <PackageReference Include="System.ComponentModel.Annotations">
      <Version>5.0.0</Version>
    </PackageReference>
  </ItemGroup>
</Project>